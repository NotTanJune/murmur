<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Murmur</string>
	<key>CFBundleDisplayName</key>
	<string>Murmur</string>
	<!-- No spaces and an exact-case match target for pkill -x. -->
	<key>CFBundleExecutable</key>
	<string>Murmur</string>
	<!-- TCC grants and preferences key on this ID. Changing it drops every grant. -->
	<key>CFBundleIdentifier</key>
	<string>ai.pivotstudio.murmur</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Folder under Contents/Resources holding Fraunces and Figtree. -->
	<key>ATSApplicationFontsPath</key>
	<string>Fonts</string>
	<!-- murmur:// links are how the local dashboard page sends actions to the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.pivotstudio.murmur</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>murmur</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- False keeps the Dock icon and app menu alongside the menu bar item. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Murmur records your voice while the dictation key is held, then converts it to text on this Mac.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Murmur uses on-device speech recognition to type what you say into the focused field.</string>
</dict>
</plist>
