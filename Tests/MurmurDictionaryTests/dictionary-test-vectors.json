{
  "$comment": [
    "Specification of DictionaryCorrector.apply. Change a vector first, watch it fail, then fix the code.",
    "R1 eligibility: only enabled corrections with a usable trigger become rules; terms never rewrite.",
    "R2 whole phrase: every trigger word, in order; a partial or reordered phrase never matches.",
    "R3 right boundary: a letter or number of any script directly after the span blocks it; punctuation, apostrophes and hyphens do not.",
    "R4 left boundary: the same on the left; start of text, hyphen, underscore and brackets allow a match.",
    "R5 separators: between trigger words the input may hold any run of whitespace and hyphens, or nothing; a trigger's own separator style is irrelevant.",
    "R6 case: matching ignores case in any script; the write text is inserted exactly as stored.",
    "R7 replacement is literal text: no templates, no back-references, empty deletes, not trimmed, not rescanned by its own rule.",
    "R8 trigger is literal: regex metacharacters match only themselves.",
    "R9 ordering: longest stored trigger first, ties by entry order, length measured on the stored string.",
    "R10 sequence: each rule sees the previous rules' output, so rules can chain on inserted text.",
    "R11 reporting: one report per rule that matched, in run order; count is the matches seen; from is the first match as it stood.",
    "R12 normalisation: trigger and text are compared as NFC; with a rule present the result is NFC, with none the text is untouched.",
    "R13 boundaries beyond ASCII: emoji and symbols are boundaries, letters of other scripts are not.",
    "Harness: text is compared by Unicode scalars; an expected correction may pin from; expected corrections are matched by to, count and, when given, from."
  ],
  "version": 1,
  "cases": [
    {
      "name": "R1 disabled correction changes nothing",
      "entries": [
        {
          "kind": "correction",
          "hear": "tail wind",
          "write": "Tailwind",
          "isEnabled": false
        }
      ],
      "input": "I use tail wind daily",
      "expected": "I use tail wind daily",
      "expectedCorrections": []
    },
    {
      "name": "R1 disabled entry beside an enabled one, only the enabled fires",
      "entries": [
        {
          "kind": "correction",
          "hear": "mongo db",
          "write": "MongoDB",
          "isEnabled": false
        },
        {
          "kind": "correction",
          "hear": "oh auth",
          "write": "OAuth"
        }
      ],
      "input": "mongo db and oh auth",
      "expected": "mongo db and OAuth",
      "expectedCorrections": [
        {
          "to": "OAuth",
          "count": 1
        }
      ]
    },
    {
      "name": "R1 term never rewrites, even when only the case differs",
      "entries": [
        {
          "kind": "term",
          "write": "Tailwind"
        }
      ],
      "input": "i like tailwind",
      "expected": "i like tailwind",
      "expectedCorrections": []
    },
