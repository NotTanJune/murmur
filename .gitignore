# macOS build
.build/
*.xcuserdatad
.DS_Store

# Built .app bundles, at the repo root ONLY.
#
# Anchored deliberately: macOS filesystems are case-insensitive, so an unanchored `*.app/`
# also matches any source folder whose name ends in ".App".
/*.app/

# Local ASR model weights. Large, redistributed under their own license, and fetched by the
# app itself.
models/
*.onnx
*.nemo

# Written by xcodebuild when `make app` builds the package.
.swiftpm/
