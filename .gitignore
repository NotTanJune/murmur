# SwiftPM and Xcode output
.build/
.swiftpm/
*.xcuserdatad
.DS_Store

# Built bundles at the repo root. The pattern is anchored because macOS paths are case-insensitive,
# so an unanchored `*.app/` would also match a source folder ending in ".App".
/*.app/

# Model weights. The app downloads them and they carry their own licenses.
models/
*.onnx
*.nemo

# Coverage output
*.profraw

# iOS app and keyboard: the local signing team and Xcode's per-user state. The generated
# project and plists are committed (Xcode Cloud builds them); regenerate with `make ios-project`.
ios/Local.xcconfig
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/

# The keyboard's language model: Tools/fetch_typing_lm.py builds it here and the keyboard target
# copies the folder. Only the placeholder that keeps the folder in a fresh checkout is committed.
ios/TypingLM/*
!ios/TypingLM/.gitkeep
